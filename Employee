SELECT * FROM Employees WHERE  SALARY BETWEEN 40000 AND 60000;

-- Employees in alphabetical order 
SELECT * FROM EMPLOYEES ORDER BY NAME ASC;

-- First 2 employees with the lowest salary
SELECT * FROM EMPLOYEES ORDER BY SALARY ASC LIMIT 2;

-- Average salary per department
Select DEPARTMENT_ID, AVG(Salary) FROM EMPLOYEES GROUP BY DEPARTMENT_ID; 

-- Departments with more than 1 employee
SELECT DEPARTMENT_ID, COUNT(*) FROM EMPLOYEES GROUP BY DEPARTMENT_ID HAVING COUNT(*)>1;

-- Maximum salary in each department
SELECT DEPARTMENT_ID, MAX(SALARY) FROM EMPLOYEES GROUP BY DEPARTMENT_ID;

-- Number of employees in each department
SELECT DEPARTMENT_ID, COUNT(*) FROM EMPLOYEES GROUP BY DEPARTMENT_ID;

-- Department with the highest total salary
SELECT DEPARTMENT_ID, SUM(SALARY) FROM EMPLOYEES GROUP BY DEPARTMENT_ID ORDER BY SUM(SALARY) DESC LIMIT 1;

-- Employees who earn more than the average salary of their department
SELECT NAME, DEPARTMENT_ID, SALARY FROM EMPLOYEES E WHERE SALARY > (
	SELECT AVG(SALARY) FROM EMPLOYEES WHERE DEPARTMENT_ID = E.DEPARTMENT_ID
);

-- Minimum and maximum salary in the IT department
SELECT MIN(SALARY), MAX(SALARY) FROM EMPLOYEES WHERE DEPARTMENT_ID=20;

-- Departments having average salary above 55000.
SELECT DEPARTMENT_ID, AVG(SALARY) FROM EMPLOYEES GROUP BY DEPARTMENT_ID HAVING AVG(SALARY)>55000;

-- Inner join
SELECT E.NAME, D.DEPARTMENT_NAME FROM EMPLOYEES E INNER JOIN DEPARTMENTS D ON E.DEPARTMENT_ID = D.DEPARTMENT_ID;

-- Left join
SELECT E.NAME, D.DEPARTMENT_NAME FROM EMPLOYEES E LEFT JOIN DEPARTMENTS D ON E.DEPARTMENT_ID = D.DEPARTMENT_ID;

-- Right join
SELECT E.NAME, D.DEPARTMENT_NAME FROM EMPLOYEES E RIGHT JOIN DEPARTMENTS D ON E.DEPARTMENT_ID = D.DEPARTMENT_ID;

-- Full outer join (In MySQL (no full join), we simulate with union)
-- SELECT E.NAME, D.DEPARTMENT_NAME FROM EMPLOYEES E FULL OUTER JOIN DEPARTMENTS D ON E.DEPARTMENT_ID = D.DEPARTMENT_ID;
SELECT E.NAME, D.DEPARTMENT_NAME FROM EMPLOYEES E LEFT JOIN DEPARTMENTS D ON E.DEPARTMENT_ID = D.DEPARTMENT_ID
UNION
SELECT E.NAME, D.DEPARTMENT_NAME FROM EMPLOYEES E RIGHT JOIN DEPARTMENTS D ON E.DEPARTMENT_ID = D.DEPARTMENT_ID;

-- Self join (Show employee and their manager’s name)
SELECT E.NAME AS EMPLOYEE, M.NAME AS MANAGER FROM EMPLOYEES E INNER JOIN EMPLOYEES M ON E.MANAGER_ID = M.MANAGER_ID;

